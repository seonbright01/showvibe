# ============================================================
# ShowVibe 환경변수 명세 (.env.example)
# 실제 값은 .env.local 에 기입 (커밋 금지)
# ============================================================

# --- Public site URL (브라우저 노출) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (Captcha) ---
# 미설정 시 검증 skip (개발용)
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# --- AWS SES (이메일 발송: takedown 응답, 뉴스레터 확인) ---
# Sandbox 모드: 검증된 발신/수신 주소만 가능
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@showvibe.app
SES_FROM_NAME=ShowVibe
SES_REPLY_TO_EMAIL=support@showvibe.app

# --- Anthropic API (AI 분류/본문 생성, 선택) ---
# 미설정 시 stub fallback
ANTHROPIC_API_KEY=

# --- GitHub Search API (수집, 선택) ---
# 미설정 시 미인증 호출 → rate-limit 60/h
GITHUB_TOKEN=

# --- 스크린샷 폴백 (Playwright 실패 시, 선택) ---
SCREENSHOTONE_ACCESS_KEY=

# --- AdSense (운영 시작 후, 선택) ---
NEXT_PUBLIC_ADSENSE_PUB_ID=

# --- Vercel Cron 보안 (Cron 활성화 시 필수) ---
CRON_SECRET=
